---
interface Props {
  type?: "note" | "warning" | "info";
}

const { type = "note" } = Astro.props;

const bgColors = {
  note: "bg-blue-50",
  warning: "bg-yellow-50",
  info: "bg-gray-50",
};

const borderColors = {
  note: "border-blue-300",
  warning: "border-yellow-300",
  info: "border-gray-300",
};

const titleColors = {
  note: "text-blue-900",
  warning: "text-yellow-900",
  info: "text-gray-900",
};

const titles = {
  note: "Note",
  warning: "Warning",
  info: "Info",
};
---

<div
  class={`rounded-lg border-l-4 p-4 ${bgColors[type]} ${borderColors[type]} my-4`}
>
  <div
    class={`flex items-center gap-2 font-semibold ${titleColors[type]} mb-2`}
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="currentColor"
      class="w-5 h-5"
    >
      <path
        fill-rule="evenodd"
        d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12zm8.706-1.442c1.146-.573 2.437.463 2.126 1.706l-.709 2.836.042-.02a.75.75 0 01.67 1.34l-.04.022c-1.147.573-2.438-.463-2.127-1.706l.71-2.836-.042.02a.75.75 0 11-.671-1.34l.041-.022zM12 9a.75.75 0 100-1.5.75.75 0 000 1.5z"
        clip-rule="evenodd"></path>
    </svg>
    {titles[type]}
  </div>
  <div class="prose-sm text-gray-700">
    <slot />
  </div>
</div>
